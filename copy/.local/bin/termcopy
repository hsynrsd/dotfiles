#!/usr/bin/env python3
"""Copy terminal text to the clipboard (Wayland, wl-copy).

Called by the `copy` shell function (fish & bash):
  copy            copy the output of the previous command (read from Konsole's screen)
  copy -c         copy the previous command line itself
  copy -r         re-run the previous command and copy its output (for output that scrolled away)
  cmd | copy      copy whatever is piped in
History entries are passed as arguments after `--hist`, newest first.
"""
import json, os, subprocess, sys

def clip(text: str, what: str):
    text = text.rstrip("\n")
    if not text.strip():
        sys.exit(f"copy: nothing to copy ({what} was empty)")
    subprocess.run(["wl-copy"], input=text.encode(), check=True)
    n = text.count("\n") + 1
    print(f"\033[2mcopied {what}: {n} line{'s' * (n != 1)}, {len(text)} chars\033[0m", file=sys.stderr)

def screen_lines():
    svc, path = os.environ.get("KONSOLE_DBUS_SERVICE"), os.environ.get("KONSOLE_DBUS_SESSION")
    if not (svc and path):
        sys.exit("copy: only works inside Konsole. Use `cmd | copy` or `copy -r` instead.")
    out = subprocess.run(
        ["busctl", "--user", "call", svc, path, "org.kde.konsole.Session",
         "getAllDisplayedTextList", "b", "true", "--json=short"],
        capture_output=True, text=True, check=True).stdout
    return [l.replace("\xa0", " ").rstrip() for l in json.loads(out)["data"][0]]

def last_output(prev: str):
    lines = screen_lines()
    while lines and not lines[-1]:
        lines.pop()
    copy_idx = len(lines) - 1                      # the line where `copy` was typed
    prev_flat = " ".join(prev.split())
    key = prev_flat[-40:]                          # tail of command, survives prompt prefixes
    cmd_idx = next((i for i in range(copy_idx - 1, -1, -1)
                    if " ".join(lines[i].split()).endswith(key)), None)
    if cmd_idx is None:
        sys.exit("copy: previous command is no longer on screen (output too long). "
                 "Use `copy -r` to re-run it, or `cmd | copy`.")
    out = lines[cmd_idx + 1:copy_idx]
    # Strip the multi-line prompt that sits above the `copy` line: lines that look like
    # the corresponding lines above the previous command's line are prompt, not output.
    for j in range(1, 4):
        a, b = cmd_idx - j, copy_idx - j
        if a >= 0 and out and lines[a] and lines[b] and lines[a][:3] == lines[b][:3]:
            out.pop()
        else:
            break
    while out and not out[-1]:
        out.pop()
    return "\n".join(out)

def main():
    args = sys.argv[1:]
    hist = args[args.index("--hist") + 1:] if "--hist" in args else []
    opts = args[:args.index("--hist")] if "--hist" in args else args
    hist = [h for h in hist if h.strip() and not h.strip().startswith("copy")]

    if not sys.stdin.isatty() and not opts:
        return clip(sys.stdin.read(), "input")
    if not hist:
        sys.exit("copy: no previous command found")
    prev = hist[0]
    if "-c" in opts:
        return clip(prev, "command")
    if "-r" in opts:
        shell = os.environ.get("COPY_SHELL", "bash")
        r = subprocess.run([shell, "-c", prev], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        sys.stdout.write(r.stdout)
        return clip(r.stdout, f"output of `{prev}`")
    if opts:
        sys.exit(__doc__)
    clip(last_output(prev), "last output")

if __name__ == "__main__":
    main()
