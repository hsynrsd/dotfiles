Window.SetBackgroundTopColor(0.075, 0.082, 0.122);
Window.SetBackgroundBottomColor(0.075, 0.082, 0.122);

sw = Window.GetWidth();
sh = Window.GetHeight();
NW = 1200;
NH = 420;
CX = 600;
CY = 190;
ox = Math.Int((sw - NW) / 2);
oy = Math.Int((sh - NH) / 2) - 60;

nx[0] = -470; ny[0] = 0;
nx[1] = -235; ny[1] = -105;
nx[2] = -235; ny[2] = 105;
nx[3] = 0;    ny[3] = 0;
nx[4] = 235;  ny[4] = -105;
nx[5] = 235;  ny[5] = 105;
nx[6] = 470;  ny[6] = 0;

la[0] = 0; lb[0] = 1;
la[1] = 0; lb[1] = 2;
la[2] = 1; lb[2] = 2;
la[3] = 1; lb[3] = 3;
la[4] = 2; lb[4] = 3;
la[5] = 3; lb[5] = 4;
la[6] = 3; lb[6] = 5;
la[7] = 4; lb[7] = 5;
la[8] = 4; lb[8] = 6;
la[9] = 5; lb[9] = 6;
NLINKS = 10;
NNODES = 7;

base = Sprite(Image("net-base.png"));
base.SetPosition(ox, oy, 1);

for (i = 0; i < NLINKS; i++)
{
  link[i] = Sprite(Image("link" + i + ".png"));
  link[i].SetPosition(ox, oy, 2);
  link[i].SetOpacity(0);
  linkop[i] = 0;
}

for (i = 0; i < NNODES; i++)
{
  node[i] = Sprite(Image("node" + i + ".png"));
  node[i].SetPosition(ox, oy, 3);
  node[i].SetOpacity(0);
}

path[0] = 0; path[1] = 1; path[2] = 3; path[3] = 4; path[4] = 6;
path[5] = 0; path[6] = 2; path[7] = 3; path[8] = 5; path[9] = 6;
path[10] = 0; path[11] = 1; path[12] = 3; path[13] = 5; path[14] = 6;
path[15] = 0; path[16] = 2; path[17] = 3; path[18] = 4; path[19] = 6;

packet_image = Image("packet.png");
NPK = 4;
for (i = 0; i < NPK; i++)
{
  pk[i] = Sprite(packet_image);
  pk[i].SetZ(4);
  pk[i].SetOpacity(0);
  pkpath[i] = i;
  pkseg[i] = 0;
  pkt[i] = 0 - i * 0.9;
}

mode = Plymouth.GetMode();
caption_image = Image("caption-boot.png");
if (mode == "shutdown" || mode == "reboot")
{
  caption_image = Image("caption-shutdown.png");
}

caption = Sprite(caption_image);
capx = Math.Int((sw - caption_image.GetWidth()) / 2);
capy = oy + NH + 40;
caption.SetPosition(capx, capy, 5);

cursor = Sprite(Image("cursor.png"));
cursor.SetPosition(capx + caption_image.GetWidth() + 4, capy + 5, 5);

prompt_image = Image("prompt.png");
prompt = Sprite(prompt_image);
prx = Math.Int((sw - prompt_image.GetWidth()) / 2);
prompt.SetPosition(prx, capy, 6);
prompt.SetOpacity(0);
bullet_image = Image("bullet.png");

progress = 0;
frame = 0;
status = "normal";

fun clamp(v, lo, hi)
{
  r = v;
  if (v < lo)
  {
    r = lo;
  }
  if (v > hi)
  {
    r = hi;
  }
  return r;
}

fun refresh_callback()
{
  global.frame = global.frame + 1;

  for (k = 0; k < global.NLINKS; k++)
  {
    target = clamp(global.progress * global.NLINKS * 1.15 - k, 0, 1);
    global.linkop[k] = global.linkop[k] + (target - global.linkop[k]) * 0.08;
    global.link[k].SetOpacity(global.linkop[k]);
  }

  for (n = 0; n < global.NNODES; n++)
  {
    best = 0;
    for (k = 0; k < global.NLINKS; k++)
    {
      if ((global.la[k] == n || global.lb[k] == n) && global.linkop[k] > best)
      {
        best = global.linkop[k];
      }
    }
    global.node[n].SetOpacity(best);
  }

  for (i = 0; i < global.NPK; i++)
  {
    global.pkt[i] = global.pkt[i] + 0.03;
    if (global.pkt[i] >= 1)
    {
      global.pkt[i] = 0;
      global.pkseg[i] = global.pkseg[i] + 1;
      if (global.pkseg[i] >= 4)
      {
        global.pkseg[i] = 0;
        global.pkpath[i] = Math.Int(Math.Random() * 4);
        if (global.pkpath[i] > 3)
        {
          global.pkpath[i] = 3;
        }
      }
    }
    if (global.pkt[i] < 0)
    {
      global.pk[i].SetOpacity(0);
    }
    else
    {
      a = global.path[global.pkpath[i] * 5 + global.pkseg[i]];
      b = global.path[global.pkpath[i] * 5 + global.pkseg[i] + 1];
      t = global.pkt[i];
      x = global.ox + global.CX + global.nx[a] + (global.nx[b] - global.nx[a]) * t - 20;
      y = global.oy + global.CY + global.ny[a] + (global.ny[b] - global.ny[a]) * t - 20;
      global.pk[i].SetPosition(x, y, 4);
      global.pk[i].SetOpacity(0.95);
    }
  }

  if (global.status == "normal")
  {
    blink = Math.Int(global.frame / 25) - 2 * Math.Int(global.frame / 50);
    if (blink == 0)
    {
      global.cursor.SetOpacity(1);
    }
    else
    {
      global.cursor.SetOpacity(0);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, p)
{
  global.progress = p;
}
Plymouth.SetBootProgressFunction(progress_callback);

fun display_normal_callback()
{
  global.status = "normal";
  global.caption.SetOpacity(1);
  global.prompt.SetOpacity(0);
  index = 0;
  while (global.bullet[index])
  {
    global.bullet[index].sprite.SetOpacity(0);
    index++;
  }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun display_password_callback(prompt_text, bullets)
{
  global.status = "password";
  global.caption.SetOpacity(0);
  global.cursor.SetOpacity(0);
  global.prompt.SetOpacity(1);
  bx = global.prx + 64;
  by = global.capy + 40 + 6 + 20 - 11;
  for (index = 0; index < bullets; index++)
  {
    if (!global.bullet[index])
    {
      global.bullet[index].sprite = Sprite(global.bullet_image);
      global.bullet[index].sprite.SetPosition(bx + index * 24, by, 7);
    }
    global.bullet[index].sprite.SetOpacity(1);
  }
  while (global.bullet[index])
  {
    global.bullet[index].sprite.SetOpacity(0);
    index++;
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun message_callback(text)
{
  global.msg_image = Image.Text(text, 0.34, 0.37, 0.54);
  global.msg = Sprite(global.msg_image);
  global.msg.SetPosition(Math.Int((global.sw - global.msg_image.GetWidth()) / 2), global.sh - 80, 8);
}
Plymouth.SetMessageFunction(message_callback);
