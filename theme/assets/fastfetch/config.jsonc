// Minimal steel fastfetch: no logo, short lowercase labels
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "38;2;86;95;137",
      "output": "38;2;169;177;214"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "  ",
      "format": "\u001b[38;2;122;162;247m{user-name}\u001b[38;2;86;95;137m @ \u001b[38;2;115;184;201m{host-name}"
    },
    {
      "type": "custom",
      "key": "  ",
      "format": "\u001b[38;2;59;66;97m─────────────────────"
    },
    {
      "type": "os",
      "key": "  os   ",
      "format": "fedora {version-id}"
    },
    {
      "type": "de",
      "key": "  de   ",
      "format": "plasma {version}"
    },
    {
      "type": "command",
      "key": "  cpu  ",
      "text": "grep -m1 'model name' /proc/cpuinfo | sed -E 's/.*(i[3579]-[0-9A-Z]+|Ryzen [0-9] [0-9A-Z]+).*/\\1/' | tr A-Z a-z"
    },
    {
      "type": "command",
      "key": "  gpu  ",
      "text": "nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | sed -E 's/.*(RTX|GTX) ?([0-9]+( Ti)?).*/\\1 \\2/' | tr A-Z a-z"
    },
    {
      "type": "memory",
      "key": "  mem  ",
      "format": "{used} / {total}"
    },
    {
      "type": "uptime",
      "key": "  up   ",
      "format": "{hours}h {minutes}m"
    },
    "break"
  ]
}