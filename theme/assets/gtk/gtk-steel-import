#!/bin/sh
# Append the Steel libadwaita colors to KDE's generated gtk.css (KDE rewrites it on scheme changes).
f=$HOME/.config/gtk-4.0/gtk.css
src=$HOME/.config/gtk-4.0/steel-adwaita.css
[ -f "$f" ] && [ -f "$src" ] || exit 0
grep -q "steel-adwaita:begin" "$f" && exit 0
{ printf '\n/* steel-adwaita:begin */\n'; cat "$src"; printf '/* steel-adwaita:end */\n'; } >> "$f"
