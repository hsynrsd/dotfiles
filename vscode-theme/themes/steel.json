  "semanticTokenColors": {
    "parameter": "#c0a88a",
    "variable.readonly": "#c99a6e",
    "property": "#89b8d6",
    "namespace": "#73b8c9",
    "type": "#73b8c9",
    "class": "#73b8c9",
    "interface": "#73b8c9",
    "enumMember": "#c99a6e"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#7a82a6" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#8fb39a" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#73b8c9" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#c99a6e" } },
    { "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#a9b1d6" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c0a88a" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "#e06c75", "fontStyle": "italic" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#d8a657" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#73b8c9" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#89b8d6" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c99a6e", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"], "settings": { "foreground": "#73b8c9", "fontStyle": "italic" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#73b8c9" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#8fb39a" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#7aa2f7" } }
  ]
}
